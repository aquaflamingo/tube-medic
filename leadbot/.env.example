# YouTube Data API v3 key (optional, for structured search)
YT_API_KEY=

# Subscriber range
MIN_SUBS=40000
MAX_SUBS=500000

# Minimum monetization score to keep a lead
MIN_SCORE=3

# Rate limiting
REQUEST_DELAY=5
MAX_ENRICHMENTS=800

# Directories (relative to working directory)
DATA_DIR=data
LOG_DIR=logs
EXPORT_DIR=exports
DB_PATH=data/leads.db

# Config file paths
KEYWORDS_PATH=config/keywords_seed.json
AGENCIES_PATH=config/agencies_seed.json

# User agent for web scraping
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
